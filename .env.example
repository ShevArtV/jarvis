TELEGRAM_TOKEN=your_token_here
ALLOWED_USER_IDS=comma,separated,user,ids

# ActiveCollab API. Заполни значения в локальном .env, не в этом шаблоне.
# ACTIVE_COLLAB_URL=https://your-company.activecollab.com
# ACTIVE_COLLAB_TOKEN=your_api_token

# Дефолтный движок LLM для новых топиков: claude (дефолт), codex или opencode.
# Существующие топики хранят свой движок в БД; переключить активный топик можно
# командой /engine <name> в самом Telegram (новый session_id под новый движок,
# cwd сохраняется, контекст прежнего диалога не переносится).
# JARVIS_ENGINE=claude

# Бинарники и таймауты — по умолчанию ищутся в PATH.
# CLAUDE_BIN=claude
# CLAUDE_TIMEOUT=3600
# CODEX_BIN=codex
# CODEX_TIMEOUT=3600
# OPENCODE_BIN=opencode
# OPENCODE_TIMEOUT=3600

# Опционально для codex: дефолтная модель, если в топике она не выбрана.
# CODEX_MODEL=gpt-5.5

# Списки моделей для /engine UI Jarvis берёт у самих CLI (claude — алиасы плюс
# ~/.claude.json; codex — ~/.codex/models_cache.json; opencode — `opencode
# models`) и перечитывает раз в JARVIS_MODELS_TTL секунд. Переменные ниже —
# override: заданы → показывается ровно этот список.
# JARVIS_MODELS_TTL=600
# CLAUDE_MODELS=opus,sonnet,haiku
# CODEX_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-mini
# OPENCODE_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash

# Опционально для opencode: если не заданы, берутся из opencode config.
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# OPENCODE_AGENT=build
# OPENCODE_VARIANT=high

# Playwright MCP — on-demand: грузится per-topic командой /browser on (по
# умолчанию выключен, чтобы не держать ~30 browser_* тулов в каждом запросе).
# JARVIS_PLAYWRIGHT_MCP — глобальный рубильник: 1 (дефолт) разрешает /browser,
# 0 полностью отключает браузер. Ниже — параметры самого Playwright MCP (CDP
# endpoint, путь к npx, capabilities). По умолчанию endpoint `chrome`.
# JARVIS_PLAYWRIGHT_MCP=1
# PLAYWRIGHT_MCP_MODE=cdp
# PLAYWRIGHT_MCP_CDP_ENDPOINT=chrome
# Абсолютный путь к npx: оболочка, из которой бот стартует движок,
# неинтерактивная и nvm не сорсит — при nvm-установке node без этого все
# MCP-серверы на npx молча не поднимаются, хотя `node -v` работает.
# PLAYWRIGHT_MCP_NPX=/home/user/.nvm/versions/node/v22.22.0/bin/npx
# PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@latest
# PLAYWRIGHT_MCP_ARGS=--caps=vision,pdf,devtools

# Дефолтный cwd для топиков без /bind. Не задан — домашний каталог.
# CLAUDE_CWD=/home/user/projects

# Топик Менеджера: топик-оркестратор, которому боты отчитываются о делегированных
# задачах и который получает роль 'manager' для внешних MCP-серверов (см. ниже).
# Нужны ОБЕ переменные, иначе Менеджера у установки просто нет — для одного
# топика он и не нужен. chat_id форума и thread_id смотри в /session.
# JARVIS_MANAGER_CHAT_ID=-1001234567890
# JARVIS_MANAGER_THREAD_ID=42

# Внешние MCP-серверы по роли топика (engines/topic_mcp.py). Позволяет одному
# форуму работать с внешним сервисом под двумя личностями: топик Менеджера
# ходит туда своими кредами, проектные топики — своими, и они не перемешиваются.
# Файла нет или переменная не задана → таких серверов просто нет, это НЕ ошибка.
# Живой пример интеграции — проект jarvis-mxboard-poller (мост из канбана
# mxBoard), он же поставляет шаблон этого файла.
# JARVIS_TOPIC_MCP_CONFIG=~/.config/jarvis/topic-mcp.json
# JARVIS_TOPIC_MCP=1   # 0 — глобально выключить все такие серверы
#
# Формат файла ('roles' необязателен — без него сервер даётся любой роли):
# {
#   "servers": [
#     {
#       "name": "mxboard",
#       "url": "https://example.org/rest-mcp.php",
#       "roles": {
#         "manager": {"headers": {"Authorization": "Bearer <manager-token>"}},
#         "agent":   {"headers": {"Authorization": "Bearer <agent-token>"}}
#       }
#     }
#   ]
# }

# Сеанс = окно терминала: открывается первым сообщением, закрывается /close
# или сам — после простоя. Топик (cwd, движок, модель) переживает закрытие,
# контекст сессии — нет. Это главный ограничитель расхода токенов: цена хода
# линейна по размеру контекста, а короткие сеансы не дают ему расти.
# 0 — выключить авто-закрытие (сеанс живёт до /close).
# JARVIS_SESSION_IDLE_MINUTES=180
